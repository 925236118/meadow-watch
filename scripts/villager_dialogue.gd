static func stage(s: RefCounted, index: int) -> int:
	var id: String=s.Village.PEOPLE[index].id
	return clampi(int(s.village.people[id].points)/s.Village.POINTS_PER_STAR,0,5)

static func line(s: RefCounted, index: int) -> String:
	var level: int=stage(s,index)
	var salt: int=s.day+int(s.village.talk_count)+s.village.mail.size()+index
	var opening: String=BONDS[index][level][salt%2]
	var observations: Array[String]=[RAIN[index] if s.weather=="小雨" else CLEAR[index],DAILY[index][(s.day-1)%4]]
	for event: Dictionary in s.village.active:
		if EVENTS.has(event.id): observations.append(EVENTS[event.id][index])
	if s.chickens>0: observations.append(CHICKENS[index])
	for ready: int in s.tree_ready_days:
		if ready>s.day: observations.append(TREES[index]);break
	if s.ap<=2: observations.append(LOW_AP[index])
	var request: Dictionary=s.village.request
	if not request.is_empty() and request.npc==s.Village.PEOPLE[index].id:
		observations.append("那天的忙你已经帮上了，东西我收好了。" if request.done else "我前几天信里提到的%s，方便时再帮我留意一下就好。"%s.item_name(request.key))
	return opening+"\n\n"+observations[salt%observations.size()]
